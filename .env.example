# Copy this file to .env and replace the placeholders with values from your
# own Supabase project. .env is ignored by Git; never commit filled credentials.
# This example mirrors the variable names in the local .env. Only URL and
# PUBLIC_KEY are read by Shelf's device build script.

# Public client configuration. The build script maps these to SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY. GitHub Pages uses those mapped names as Actions
# variables. A publishable key is visible to anyone using the browser app.
URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_KEY=sb_publishable_REPLACE_ME

# Private Supabase/database credentials for local administration only. Shelf
# and the GitHub Pages workflow do not use them. Never pass these values to
# Flutter, GitHub Actions variables, or a public build.
SECRET_KEY=replace_with_private_secret_key
URI=replace_with_private_database_connection_uri
PASSWORD=replace_with_private_database_password
host=replace_with_private_database_host
port=replace_with_database_port
database=replace_with_database_name
user=replace_with_database_user
